# SnapSolve AI - Hostinger Production Environment Configuration
# Copy this file to .env or add these variables in Hostinger hPanel -> Node.js -> Environment Variables

# REQUIRED: Google Gemini API Key for screenshot vision analysis and AI chat
# Obtain your free API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# PORT: Hostinger automatically manages ports (or defaults to 3000)
PORT=3000

# NODE_ENV: Set to production
NODE_ENV=production
